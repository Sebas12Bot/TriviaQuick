# TriviaQuick backend: variables de entorno. Copia los valores en tu plataforma de despliegue;
# nunca los subas al repositorio.

# PostgreSQL (vacío = PostgreSQL embebido, solo para desarrollo)
DB_URL=postgres://usuario:clave@host:5432/triviaquick
DB_USERNAME=
DB_PASSWORD=
DB_POOL_SIZE=10

# JWT: obligatorio en producción, mínimo 32 bytes aleatorios
JWT_SECRET=
JWT_EXPIRATION_MINUTES=240

# Cookie de sesión (en producción con HTTPS: COOKIE_SECURE=true; si el frontend vive en otro dominio: COOKIE_SAME_SITE=None)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Orígenes autorizados para CORS y WebSocket (separados por comas)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Código para registrar cuentas de docente (vacío = registro de docentes deshabilitado)
TEACHER_SIGNUP_CODE=

# Límite de respuestas por usuario
ANSWER_RATE_LIMIT=12
ANSWER_RATE_WINDOW_SECONDS=10

# Datos de demostración (desactivar en producción). Sin DEMO_PASSWORD no se crean.
SEED_DEMO_DATA=true
DEMO_PASSWORD=

# Imágenes subidas (avatares y cuestionarios). En producción, un volumen persistente.
UPLOAD_DIR=

# Correo (verificación del cambio de correo). Sin MAIL_HOST, el enlace se escribe en el log (solo desarrollo).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=TriviaQuick <no-reply@tu-dominio>
# URL pública del frontend, usada en los enlaces de los correos
APP_PUBLIC_URL=http://localhost:5173

# Swagger UI / OpenAPI
OPENAPI_ENABLED=true
PORT=8080
